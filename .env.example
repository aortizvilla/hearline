# Copy to hearline/backend/.env (or the repo root) and fill in real values. Never commit .env.
# Where data lives (relative paths are resolved from hearline/backend/):
# 1. Records: users, profiles, topics, stories, episode details, costs, jobs (Postgres in production)
DATABASE_URL=sqlite:///storage/hearline.db
# 2. Audio files: shared story clips + each user's episode MP3s (S3/R2 in production)
AUDIO_DIR=storage/audio

# --- Content pipeline -------------------------------------------------------
# LLM provider for research, writing, verification and topic resolution: openai | anthropic | mock
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Model ids (prices live in config/pricing.yaml). Cheapest setup that holds quality:
RESEARCHER_MODEL=gpt-5.4-mini     # web search + story extraction
WRITER_MODEL=gpt-5.4-mini         # clip scripts
SMALL_MODEL=gpt-5.4-nano          # fact-check, topic matching, spoken phrases (greeting, transitions, outro)

# Text to speech: elevenlabs (default) | polly | say (macOS, free) | mock
TTS_PROVIDER=elevenlabs
# Amazon Polly, only if TTS_PROVIDER=polly (or leave empty to use ~/.aws / an IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# ElevenLabs: elevenlabs.io -> Developers -> API Keys (Text to Speech + Voices read)
ELEVENLABS_API_KEY=

# --- Production (see hearlineCDK/README.md) ---------------------------------------
# APP_ENV=production refuses to start with dev settings (no login, SQLite, local audio)
APP_ENV=dev
# Login: dev (X-User-Id header, no login) | clerk (verify Clerk session tokens)
AUTH_MODE=dev
CLERK_ISSUER=
# CLERK_AUTHORIZED_PARTIES=["https://hearline.app"]
# Admin dashboard (/admin): Clerk user ids allowed in. Everyone is admin in AUTH_MODE=dev.
# ADMIN_USER_IDS=["user_2abc..."]
# Audio files: local (served by the API, dev only) | s3 (private bucket, signed links)
AUDIO_STORAGE=local
AUDIO_BUCKET=
# Optional: signed links through CloudFront instead of straight from S3
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=
CLOUDFRONT_PRIVATE_KEY=

# Private podcast feeds (app/api/feed.py): public address of the API, and optional cover art
PUBLIC_BASE_URL=http://localhost:8000
PODCAST_IMAGE_URL=

# Alerts (job failed for good, daily budget cap, failed plan): Slack/Teams/Discord webhook
ALERT_WEBHOOK_URL=

# Optional overrides of config/pipeline.yaml
# EMBEDDING_PROVIDER=hashing  # sentence-transformers | hashing
# DAILY_BUDGET_USD=25

