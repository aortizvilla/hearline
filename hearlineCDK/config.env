# Production settings for deploy.sh (not secrets: safe to commit).
# Secrets (API keys) come from hearline/backend/.env and go to AWS SSM Parameter Store, never into git.

# The domain registered in Route 53 (its hosted zone is created with the registration)
DOMAIN=
# CloudFront needs its certificate in us-east-1, so the whole stack lives there
AWS_REGION=us-east-1
# Server size: t4g.medium = 2 vCPU / 4 GB (API + worker + Postgres + embeddings)
INSTANCE_TYPE=t4g.medium

# Clerk production instance (dashboard -> API keys). Both are public values.
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
# Clerk user ids allowed into /admin, JSON list, e.g. ["user_2abc"]
ADMIN_USER_IDS=[]

# Hard daily spend cap for the pipeline (USD)
DAILY_BUDGET_USD=25

# Optional: email for app alerts (failed jobs, daily cap, failed plan) and the AWS budget alarm.
# AWS sends a confirmation email first; alerts arrive only after you confirm it.
ALERT_EMAIL=
MONTHLY_BUDGET_USD=60
